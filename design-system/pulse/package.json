{
  "name": "pulse-design-system",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src scripts && node scripts/dev/check-weights.mjs",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "figma:extract": "node --max-old-space-size=12000 scripts/figma/pulse-extract.mjs",
    "figma:variables": "node --max-old-space-size=8192 scripts/figma/pulse-variables.mjs",
    "components:index": "node scripts/dev/gen-index.mjs",
    "demos:sweep": "node scripts/dev/sweep-demos.mjs .sweep",
    "symbols:build": "node --max-old-space-size=8192 scripts/generate/pulse-symbols.mjs",
    "figma:spec": "node scripts/figma/pulse-spec.mjs",
    "demos:shot": "node scripts/dev/shot-component.mjs",
    "loaders:build": "node --max-old-space-size=8192 scripts/generate/pulse-loaders.mjs",
    "check:weights": "node scripts/dev/check-weights.mjs",
    "stories:build": "node scripts/generate/stories.mjs",
    "ai:build": "node scripts/generate/ai-manifest.mjs",
    "figma:frame": "node --max-old-space-size=8192 scripts/figma/frame-to-components.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/x-data-grid": "^9.17.0",
    "@mui/x-date-pickers": "^9.17.0",
    "@mui/x-tree-view": "^9.17.0",
    "@tiptap/extension-link": "^3.33.0",
    "@tiptap/extension-placeholder": "^3.33.0",
    "@tiptap/extension-underline": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "dayjs": "^1.11.23",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "kiwi-schema": "^0.5.0",
    "oxlint": "^1.90.0",
    "storybook": "^10.6.6",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
